# URL pública desta API (obrigatório em produção com domínio próprio).
# Ex.: https://api.seudominio.com.br (sem barra no final)
# Na Vercel com domínio customizado, use a URL do domínio.
# Se não definir, em deploy na Vercel será usada a URL *.vercel.app.
NEXT_PUBLIC_BASE_URL=

# API Hub (Nova Vida / integrações)
HUBCREDITO_API_BASE_URL=
HUBCREDITO_API_USERNAME=
HUBCREDITO_API_PASSWORD=

# C6 Bank (credenciais apenas em .env.local, não commitar)
# C6BANK_USERNAME=
# C6BANK_PASSWORD=

# Facta – Consulta Dados CLT / Crédito do Trabalhador
# Homologação: https://webservice-homol.facta.com.br
# Produção: https://webservice.facta.com.br
FACTA_API_BASE_URL=https://webservice-homol.facta.com.br
FACTA_API_USERNAME=
FACTA_API_PASSWORD=
# Opcional: timeout em ms (padrão 30000)
# FACTA_API_TIMEOUT_MS=30000
# Opcional: caminho da consulta de vínculos (padrão: /consignado-trabalhador/autoriza-consulta)
# FACTA_CONSULTAR_VINCULOS_PATH=/consignado-trabalhador/autoriza-consulta
# Opcional: ativar logs do registro ('1' para sim)
# FACTA_API_LOG=0
# Opcional: código do averbador para Crédito do Trabalhador (manual v9.0).
# Se não definido, o sistema usará 10010 por padrão.
# FACTA_AVERBADOR_ID=10010

# Facta Offline – Consulta CLT base offline (cltoff-homol / cltoff)
# Homologação: https://cltoff-homol.facta.com.br | Produção: https://cltoff.facta.com.br
# Se usar o mesmo usuário da Facta (acima), basta definir BASE_URL; USERNAME/password usam FACTA_API_*
FACTA_OFFLINE_API_BASE_URL=
FACTA_OFFLINE_API_USERNAME=
FACTA_OFFLINE_API_PASSWORD=
# Opcional: timeout em ms (padrão 30000)
# FACTA_OFFLINE_API_TIMEOUT_MS=30000
# Opcional: logs do registro ('1' para ativar)
# FACTA_OFFLINE_API_LOG=0

# Nossa Fintech (CLT) — documentação: https://nossa-fintech-doc.spixiiservices.com.br/docs/intro
# NOSSA_FINTECH_API_BASE_URL=https://nossa-fintech-api.spixiiservices.com.br
# NOSSA_FINTECH_API_CPF=
# NOSSA_FINTECH_API_PASSWORD=
# NOSSA_FINTECH_API_PROMOT_ID=1
# No browser (config padrão no painel), use também NEXT_PUBLIC_* com os mesmos valores.

# Presença Bank (Consignado Privado CLT)
# Credenciais e base URL são configuradas por API no sistema. Opcional:
# PRESENCA_API_TIMEOUT_MS=120000
# Path do endpoint de solicitação de autorização (gerar termo) — usado no fluxo CLT da collection ConsignadoPrivado
PRESENCA_AUTORIZACAO_PATH=/consultas/termo-inss
# Header tenant-id ao assinar termo (PUT). Padrão: superuser
# PRESENCA_TERMO_TENANT_ID=superuser
# Se a API Presença retornar 500 no PUT de assinatura: defina true para pular a assinatura (a consulta pode ainda exigir autorização válida)
# PRESENCA_SKIP_TERMO_ASSINATURA=false
